```gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/*.tfvars
terraform/*.tfvars.json
terraform/.terraform.lock.hcl

# Ansible
ansible/inventory.ini

# SSH Keys
*.pem
*.key

# Environment files
.env
.env.*

# Kubernetes temp files
*.yaml.bak

# Jenkins
workspace/

# Python cache
__pycache__/
*.pyc
```
